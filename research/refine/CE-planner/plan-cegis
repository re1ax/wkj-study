PLAN_CHILD_PID=""
PLAN_CHILD_SESSION=""
PLAN_TERMINATING=0

collect_plan_descendants() {
    parent=$1
    if command -v pgrep >/dev/null 2>&1; then
        pgrep -P "$parent" 2>/dev/null || true
    else
        ps -eo pid=,ppid= 2>/dev/null | awk -v p="$parent" '$2 == p {print $1}'
    fi
}

signal_plan_tree_recursive() {
    parent=$1
    signal_name=$2
    for child in $(collect_plan_descendants "$parent"); do
        signal_plan_tree_recursive "$child" "$signal_name"
    done
    kill -"$signal_name" "$parent" 2>/dev/null || true
}

signal_plan_session() {
    signal_name=$1
    [ -n "$PLAN_CHILD_PID" ] || return 0
    # Snapshot and signal descendants before terminating the session leader.
    # Otherwise a child that called setsid() is reparented immediately and is
    # no longer discoverable through the original plan process.
    signal_plan_tree_recursive "$PLAN_CHILD_PID" "$signal_name"
    if [ -n "$PLAN_CHILD_SESSION" ]; then
        if command -v pkill >/dev/null 2>&1; then
            pkill -"$signal_name" -s "$PLAN_CHILD_SESSION" 2>/dev/null || true
        fi
        kill -"$signal_name" -- "-$PLAN_CHILD_SESSION" 2>/dev/null || true
    fi
}

terminate_plan_session() {
    [ -n "$PLAN_CHILD_PID" ] || return 0
    [ "$PLAN_TERMINATING" -eq 0 ] || return 0
    PLAN_TERMINATING=1
    signal_plan_session TERM
    deadline=$(( $(date +%s) + 3 ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        if ! kill -0 "$PLAN_CHILD_PID" 2>/dev/null; then
            break
        fi
        sleep 0.05
    done
    signal_plan_session KILL
    wait "$PLAN_CHILD_PID" 2>/dev/null || true
    PLAN_TERMINATING=0
}

handle_plan_signal() {
    signal_number=$1
    terminate_plan_session
    trap - TERM INT HUP EXIT
    exit $((128 + signal_number))
}

cleanup_plan_wrapper() {
    terminate_plan_session
}

trap 'handle_plan_signal 15' TERM
trap 'handle_plan_signal 2' INT
trap 'handle_plan_signal 1' HUP
trap 'cleanup_plan_wrapper' EXIT

if command -v setsid >/dev/null 2>&1; then
    setsid ./plan "$DOMAIN_FILE" "$PROBLEM_FILE" "$3" "$4" &
    PLAN_CHILD_PID=$!
    PLAN_CHILD_SESSION=$PLAN_CHILD_PID
else
    ./plan "$DOMAIN_FILE" "$PROBLEM_FILE" "$3" "$4" &
    PLAN_CHILD_PID=$!
    PLAN_CHILD_SESSION=""
fi

set +e
wait "$PLAN_CHILD_PID"
PLAN_EXIT_STATUS=$?
set -e

# The foreground plan process has ended.  Kill any background descendants that
# remained in its private session before this wrapper exits.
signal_plan_session TERM
sleep 0.10
signal_plan_session KILL
PLAN_CHILD_PID=""
PLAN_CHILD_SESSION=""
trap - TERM INT HUP EXIT
exit "$PLAN_EXIT_STATUS"
