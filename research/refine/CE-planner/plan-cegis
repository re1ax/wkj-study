#!/bin/sh
set -eu

SCRIPT_NAME=${0##*/}
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -x "$SCRIPT_DIR/.local/python2/bin/python2" ]; then
    PATH="$SCRIPT_DIR/.local/python2/bin:$PATH"
    export PATH
fi

if [ -x "$SCRIPT_DIR/.local/python3/bin/python3" ]; then
    PATH="$SCRIPT_DIR/.local/python3/bin:$PATH"
    export PATH
    if [ -z "${IGC_ICPCES_PYTHON:-}" ]; then
        IGC_ICPCES_PYTHON="$SCRIPT_DIR/.local/python3/bin/python3"
        export IGC_ICPCES_PYTHON
    fi
fi

if [ -x "$SCRIPT_DIR/.local/sicstus/bin/sicstus" ]; then
    PATH="$SCRIPT_DIR/.local/sicstus/bin:$PATH"
    export PATH
fi

print_usage() {
    cat <<'EOF'
用法：
  plan-cegis <domain.pddl> <problem.pddl> <result_file> <true|false>

必需环境变量：
  IGC_CANDIDATE_PLANNER
      候选规划器，可选：
      t0, t1, cff, pond, cnf, dnf, pip, cpah,
      igc, gc_lama, gcpces, icpces

严格执行模型：
  refined 迭代只生成并求解反例诱导的中间 PDDL。
  refined 得到新的 counterexample 时继续下一轮 refined；仅真实失败、重复反例或无新信息时执行 native fallback。
  native fallback 只读取 test/.native-fallback 中对应规划器的原生 domain/problem 或预合成 AL，
  禁止 generated full PDDL、RefinedProblemWriter、CE PDDL adapter 和 CE AL repair。
  启动时先预检查原生 benchmark 工件：
    - 工件不存在：进入 CE_ONLY，全部 CE 累计预算默认 3600 秒，不尝试 fallback；
    - 工件存在：进入 CE_PROBE，先按规划器预算试探 CE，达到单轮/迭代/累计上限后执行一次 native fallback。
  refined planner 超时或外层终止时，wrapper 与 C++ 共同清理完整进程树。

配置档：
  IGC_FALLBACK_PROFILE=stable        默认。启动前进行 native artifact preflight：
                                     无原生工件时 CE-only 累计运行至 3600 秒；
                                     有原生工件时使用线路级 CE probe，达到预算后执行一次 native fallback。
  IGC_FALLBACK_PROFILE=direct        第 0 轮直接执行 native fallback，不生成中间 PDDL。
  IGC_FALLBACK_PROFILE=no-time-gate  与 stable 相同，但 refined 不使用内部 180 秒门限。
  IGC_FALLBACK_PROFILE=quick-debug   与 stable 相同，refined 门限为 30 秒。

stable 默认 CE probe 参数（仅对已有日志与原生表支持的五条线启用）：
  CFF 30秒×3轮；DNF 60秒×3轮；Pond 30秒×2轮；T0 30秒×3轮；T1 60秒×3轮。
  其他线路保持 v13 的现有 refined timeout/触发逻辑，可通过下列变量显式覆盖：
    IGC_CE_PROBE_SINGLE_TIMEOUT
    IGC_CE_PROBE_MAX_REFINED_ITERATIONS
    IGC_CE_PROBE_TOTAL_BUDGET
  无原生工件时统一使用 IGC_CE_ONLY_TOTAL_BUDGET，默认 3600 秒。

常用示例：
  # 默认严格 stable 模式
  IGC_CANDIDATE_PLANNER=dnf \
    ./plan-cegis domain.pddl problem.pddl result.txt false

  # 直接核对原生 fallback
  IGC_FALLBACK_PROFILE=direct \
    ./run-test-ce.sh -s cpah -b bomb -p p20-5

  # 输出实际生效的严格 fallback 配置
  IGC_PRINT_FALLBACK_CONFIG=1 \
    ./run-test-ce.sh -s t1 -b omlette -p p20

不可覆盖的安全约束：
  IGC_FULL_FALLBACK_NATIVE_BENCHMARK_DIRECT=1
  IGC_FALLBACK_NATIVE_ONLY=1
  IGC_GENERATED_FULL_FALLBACK=0
  IGC_FALLBACK_AFTER_EVERY_REFINED_NONVALID=0
  IGC_FALLBACK_COUNTS_AS_ITERATION=1
EOF
}

fail() {
    echo "[$SCRIPT_NAME] 错误：$*" >&2
    exit 1
}

warn() {
    echo "[$SCRIPT_NAME] 警告：$*" >&2
}

# 校验布尔变量。底层 C++ 支持多种布尔写法，这里保留常见写法。
validate_bool_var() {
    var_name=$1
    eval "var_value=\${$var_name}"
    case "$var_value" in
        0|1|true|false|TRUE|FALSE|on|off|ON|OFF|yes|no|YES|NO) ;;
        *) fail "$var_name 必须是 0/1、true/false、on/off 或 yes/no，当前值：$var_value" ;;
    esac
}

# 判断一个已经通过校验的布尔值是否为真。
bool_is_true() {
    case "$1" in
        1|true|TRUE|on|ON|yes|YES) return 0 ;;
        *) return 1 ;;
    esac
}

# 校验非负整数。
validate_nonnegative_int_var() {
    var_name=$1
    eval "var_value=\${$var_name}"
    case "$var_value" in
        ''|*[!0-9]*) fail "$var_name 必须是非负整数，当前值：$var_value" ;;
    esac
}

# 校验正整数。
validate_positive_int_var() {
    var_name=$1
    eval "var_value=\${$var_name}"
    case "$var_value" in
        ''|*[!0-9]*) fail "$var_name 必须是正整数，当前值：$var_value" ;;
    esac
    [ "$var_value" -ge 1 ] || fail "$var_name 必须大于等于 1，当前值：$var_value"
}

if [ "$#" -eq 1 ]; then
    case "$1" in
        -h|--help|help)
            print_usage
            exit 0
            ;;
    esac
fi

if [ "$#" -ne 4 ]; then
    print_usage >&2
    exit 1
fi

: "${IGC_CANDIDATE_RUNTIME_MODE:=isolated}"
export IGC_CANDIDATE_RUNTIME_MODE
: "${IGC_CANDIDATE_PLANNER:?必须设置 IGC_CANDIDATE_PLANNER，例如 dnf、t1、cff 或 pond}"

case "$1" in
    /*) DOMAIN_FILE=$1 ;;
    *)  DOMAIN_FILE=$PWD/$1 ;;
esac
case "$2" in
    /*) PROBLEM_FILE=$2 ;;
    *)  PROBLEM_FILE=$PWD/$2 ;;
esac

# 保存用户实际传入的公共 benchmark 身份。后续 typed-list 规范化会把
# DOMAIN_FILE/PROBLEM_FILE 改成 /tmp 下的副本；native-direct fallback 必须
# 继续使用这里的原始 test 路径查找：
#   test/.native-fallback/<Planner-Benchmark>/<domain>/<problem>
# 而 LAMA/SAS 与最终 verifier 仍使用规范化副本。
PUBLIC_DOMAIN_FILE=$(readlink -f "$DOMAIN_FILE")
PUBLIC_PROBLEM_FILE=$(readlink -f "$PROBLEM_FILE")
PUBLIC_DOMAIN_DIR=$(dirname "$PUBLIC_PROBLEM_FILE")
PUBLIC_TEST_ROOT=$(dirname "$PUBLIC_DOMAIN_DIR")
PUBLIC_DOMAIN_NAME=$(basename "$PUBLIC_DOMAIN_DIR")
PUBLIC_PROBLEM_BASENAME=$(basename "$PUBLIC_PROBLEM_FILE")

# 兼容已使用的旧变量名。
export IGC_BENCHMARK_DOMAIN_PATH="$PUBLIC_DOMAIN_FILE"
export IGC_BENCHMARK_PROBLEM_PATH="$PUBLIC_PROBLEM_FILE"

# v6 C++ 使用的显式变量名。
export IGC_PUBLIC_SOURCE_DOMAIN="$PUBLIC_DOMAIN_FILE"
export IGC_PUBLIC_SOURCE_PROBLEM="$PUBLIC_PROBLEM_FILE"
export IGC_PUBLIC_TEST_ROOT="$PUBLIC_TEST_ROOT"
export IGC_PUBLIC_DOMAIN_NAME="$PUBLIC_DOMAIN_NAME"
export IGC_PUBLIC_PROBLEM_BASENAME="$PUBLIC_PROBLEM_BASENAME"

# 若用户没有明确覆盖，原生 benchmark 库根目录就是当前公共 test 根目录。
: "${IGC_NATIVE_BENCHMARK_ROOT:=$PUBLIC_TEST_ROOT}"
export IGC_NATIVE_BENCHMARK_ROOT
export IGC_FULL_FALLBACK_NATIVE_BENCHMARK_DIRECT=1

# 在进入 LAMA 翻译器之前，将紧凑 typed-list 写法（例如 "?x -pos"）
# 规范为标准 PDDL 写法（"?x - pos"）。部分旧 DNF 测例可被 CPA 前端
# 接受，却会在 CEGIS renderer 运行前被 translate.py 拒绝。
# 设置 IGC_NORMALIZE_TYPED_LISTS=0 可关闭该处理。
if [ "${IGC_NORMALIZE_TYPED_LISTS:-1}" != "0" ]; then
    NORMALIZED_DIR="${IGC_NORMALIZED_PDDL_DIR:-/tmp/igc-normalized-pddl-$$}"
    mkdir -p "$NORMALIZED_DIR"
    NORMALIZED_DOMAIN="$NORMALIZED_DIR/domain.normalized.pddl"
    NORMALIZED_PROBLEM="$NORMALIZED_DIR/problem.normalized.pddl"
    python3 - "$DOMAIN_FILE" "$NORMALIZED_DOMAIN" "$PROBLEM_FILE" "$NORMALIZED_PROBLEM" <<'PY_NORMALIZE'
import sys
from pathlib import Path

def normalize(text):
    out = []
    in_comment = False
    in_string = False
    rewrites = 0
    for i, ch in enumerate(text):
        if in_comment:
            out.append(ch)
            if ch == '\n':
                in_comment = False
            continue
        if ch == ';' and not in_string:
            in_comment = True
            out.append(ch)
            continue
        if ch == '"':
            in_string = not in_string
            out.append(ch)
            continue
        if (not in_string and ch == '-' and i + 1 < len(text)
                and (text[i + 1].isalpha() or text[i + 1] in '_?')):
            prev = out[-1] if out else ''
            if prev.isspace() or prev in '()':
                out.append('-')
                out.append(' ')
                rewrites += 1
                continue
        out.append(ch)
    return ''.join(out), rewrites

total = 0
for src, dst in ((sys.argv[1], sys.argv[2]), (sys.argv[3], sys.argv[4])):
    text = Path(src).read_text(errors='ignore')
    fixed, n = normalize(text)
    Path(dst).write_text(fixed)
    total += n
print(f"[IGC-PDDL-NORMALIZE] typed_dash_rewrites={total} domain={sys.argv[2]} problem={sys.argv[4]}")
PY_NORMALIZE
    DOMAIN_FILE="$NORMALIZED_DOMAIN"
    PROBLEM_FILE="$NORMALIZED_PROBLEM"
fi

export IGC_ORIGINAL_DOMAIN="$DOMAIN_FILE"
export IGC_ORIGINAL_PROBLEM="$PROBLEM_FILE"
export IGC_CEGIS_MODE=1
export IGC_REFINED_MODE="${IGC_REFINED_MODE:-structured}"
export IGC_REFINED_VALIDATION="${IGC_REFINED_VALIDATION:-basic}"
export IGC_CANDIDATE_TIMEOUT="${IGC_CANDIDATE_TIMEOUT:-3600}"

###############################################################################
# v16 CE 进展感知的两阶段状态机 + 完整进程树回收
#
# REFined iteration:
#   仅生成并求解反例诱导的中间 PDDL。
# NATIVE_FALLBACK iteration:
#   仅从 IGC_NATIVE_BENCHMARK_ROOT/.native-fallback 中解析原生 benchmark pair。
#
# 下面五项是不可被外部环境重新开启/关闭的安全约束。旧 generated full
# fallback、旧迭代上限 fallback、pre-planner fallback 和 CE fallback repair
# 均被强制关闭，防止环境变量污染实际控制流。
###############################################################################
export IGC_FULL_FALLBACK_NATIVE_BENCHMARK_DIRECT=1
export IGC_FALLBACK_NATIVE_ONLY=1
export IGC_GENERATED_FULL_FALLBACK=0
export IGC_FALLBACK_AFTER_EVERY_REFINED_NONVALID=0
export IGC_FALLBACK_COUNTS_AS_ITERATION=1

# 清除旧实现中可能改变 fallback 路径的环境变量。C++ v11 不再依赖这些变量，
# 这里显式固定为关闭，便于配置快照和日志审计。
export IGC_CE_ITERATION_FALLBACK=0
export IGC_CE_ITERATION_FALLBACK_LIMIT=
export IGC_FULL_FALLBACK_RETRY_AFTER_PLANNER_FAILURE=0
export IGC_FULL_FALLBACK_RETRY_AFTER_COUNTEREXAMPLE=0
export IGC_ADAPTIVE_FULL_FALLBACK_PRE_PLANNER=0
export IGC_POND_FULL_FALLBACK_PRE_PLANNER=0
export IGC_ADAPTIVE_LATE_COMPONENT_BASELINE=0
export IGC_FULL_FALLBACK_NATIVE_DOMAIN_MODE=required
export IGC_NATIVE_DOMAIN_CATALOG_ROOT=

# 兼容旧 direct 别名，但 profile 最终决定是否第 0 轮直接 native。
if [ "${IGC_FORCE_FULL_FALLBACK+x}" != x ] && \
   [ "${IGC_DIRECT_FULL_FALLBACK+x}" = x ]; then
    IGC_FORCE_FULL_FALLBACK=$IGC_DIRECT_FULL_FALLBACK
fi

: "${IGC_FALLBACK_PROFILE:=stable}"
: "${IGC_ADAPTIVE_RENDER_PROFILE:=adaptive}"
: "${IGC_CE_GUIDANCE_REFINED_TIMEOUT_MIN_ITERATION:=0}"
: "${IGC_CE_GUIDANCE_CANDIDATE_FAILURE_MIN_ITERATION:=0}"
: "${IGC_SUPERB_MODE:=off}"
: "${IGC_PRINT_FALLBACK_CONFIG:=1}"
: "${IGC_CE_ONLY_TOTAL_BUDGET:=3600}"
: "${IGC_CE_PROBE_SINGLE_TIMEOUT:=}"
: "${IGC_CE_PROBE_MAX_REFINED_ITERATIONS:=}"
: "${IGC_CE_PROBE_TOTAL_BUDGET:=}"

case "$IGC_FALLBACK_PROFILE" in
    stable)
        IGC_FORCE_FULL_FALLBACK=0
        IGC_CE_GUIDANCE_FALLBACK=1
        IGC_CE_GUIDANCE_LIMIT_REFINED_TIME=1
        : "${IGC_CE_GUIDANCE_REFINED_TIMEOUT:=180}"
        ;;
    direct)
        IGC_FORCE_FULL_FALLBACK=1
        IGC_CE_GUIDANCE_FALLBACK=0
        IGC_CE_GUIDANCE_LIMIT_REFINED_TIME=0
        : "${IGC_CE_GUIDANCE_REFINED_TIMEOUT:=180}"
        ;;
    no-time-gate)
        IGC_FORCE_FULL_FALLBACK=0
        IGC_CE_GUIDANCE_FALLBACK=1
        IGC_CE_GUIDANCE_LIMIT_REFINED_TIME=0
        : "${IGC_CE_GUIDANCE_REFINED_TIMEOUT:=180}"
        ;;
    quick-debug)
        IGC_FORCE_FULL_FALLBACK=0
        IGC_CE_GUIDANCE_FALLBACK=1
        IGC_CE_GUIDANCE_LIMIT_REFINED_TIME=1
        : "${IGC_CE_GUIDANCE_REFINED_TIMEOUT:=30}"
        : "${IGC_CE_PROBE_SINGLE_TIMEOUT:=30}"
        ;;
    refined-diagnostic)
        fail "v16 禁止 refined-diagnostic：refined 真实失败或无新信息时仍必须执行 native fallback"
        ;;
    *)
        fail "不支持的 IGC_FALLBACK_PROFILE=$IGC_FALLBACK_PROFILE；可选 stable、direct、no-time-gate、quick-debug"
        ;;
esac

export IGC_FALLBACK_PROFILE
export IGC_ADAPTIVE_RENDER_PROFILE
export IGC_FORCE_FULL_FALLBACK
export IGC_CE_GUIDANCE_FALLBACK
export IGC_CE_GUIDANCE_LIMIT_REFINED_TIME
export IGC_CE_GUIDANCE_REFINED_TIMEOUT
export IGC_CE_GUIDANCE_REFINED_TIMEOUT_MIN_ITERATION
export IGC_CE_GUIDANCE_CANDIDATE_FAILURE_MIN_ITERATION
export IGC_CE_ONLY_TOTAL_BUDGET
export IGC_CE_PROBE_SINGLE_TIMEOUT
export IGC_CE_PROBE_MAX_REFINED_ITERATIONS
export IGC_CE_PROBE_TOTAL_BUDGET
export IGC_SUPERB_MODE
export IGC_PRINT_FALLBACK_CONFIG

# v16 的 native fallback 是 CE probe 之后的最终原生尝试；无论 stable
# 还是 direct，native 非 VALID 后均结束当前测例，不再重新进入相同 probe。
export IGC_FULL_FALLBACK_RESUME_AFTER_PLANNER_FAILURE=0

for bool_var in \
    IGC_FORCE_FULL_FALLBACK \
    IGC_CE_GUIDANCE_FALLBACK \
    IGC_CE_GUIDANCE_LIMIT_REFINED_TIME \
    IGC_FULL_FALLBACK_NATIVE_BENCHMARK_DIRECT \
    IGC_FALLBACK_NATIVE_ONLY \
    IGC_GENERATED_FULL_FALLBACK \
    IGC_FALLBACK_AFTER_EVERY_REFINED_NONVALID \
    IGC_FALLBACK_COUNTS_AS_ITERATION \
    IGC_FULL_FALLBACK_RESUME_AFTER_PLANNER_FAILURE
 do
    validate_bool_var "$bool_var"
done
validate_positive_int_var IGC_CE_GUIDANCE_REFINED_TIMEOUT
validate_positive_int_var IGC_CE_ONLY_TOTAL_BUDGET
if [ -n "$IGC_CE_PROBE_SINGLE_TIMEOUT" ]; then
    validate_positive_int_var IGC_CE_PROBE_SINGLE_TIMEOUT
fi
if [ -n "$IGC_CE_PROBE_MAX_REFINED_ITERATIONS" ]; then
    validate_positive_int_var IGC_CE_PROBE_MAX_REFINED_ITERATIONS
fi
if [ -n "$IGC_CE_PROBE_TOTAL_BUDGET" ]; then
    validate_positive_int_var IGC_CE_PROBE_TOTAL_BUDGET
fi
validate_nonnegative_int_var IGC_CE_GUIDANCE_REFINED_TIMEOUT_MIN_ITERATION
validate_nonnegative_int_var IGC_CE_GUIDANCE_CANDIDATE_FAILURE_MIN_ITERATION

# 强制确认不可变安全约束没有被脚本后续逻辑污染。
[ "$IGC_FULL_FALLBACK_NATIVE_BENCHMARK_DIRECT" = 1 ] || fail "native direct 必须启用"
[ "$IGC_FALLBACK_NATIVE_ONLY" = 1 ] || fail "fallback 必须为 native-only"
[ "$IGC_GENERATED_FULL_FALLBACK" = 0 ] || fail "generated full fallback 必须关闭"
[ "$IGC_FALLBACK_AFTER_EVERY_REFINED_NONVALID" = 0 ] || fail "新的 counterexample 不得触发 fallback"
[ "$IGC_FALLBACK_COUNTS_AS_ITERATION" = 1 ] || fail "fallback 必须计为独立迭代"

print_fallback_config() {
    echo "[IGC-FALLBACK-CONFIG] version=v16-cff-cee-native-library profile=$IGC_FALLBACK_PROFILE planner=$IGC_CANDIDATE_PLANNER runtime=$IGC_CANDIDATE_RUNTIME_MODE"
    echo "[IGC-FALLBACK-CONFIG] state_machine=NATIVE_PREFLIGHT,CE_ONLY_OR_CE_PROBE,PROBE_BUDGET_TO_NATIVE fallback_counts_as_iteration=$IGC_FALLBACK_COUNTS_AS_ITERATION"
    echo "[IGC-FALLBACK-CONFIG] native_only=$IGC_FALLBACK_NATIVE_ONLY native_direct=$IGC_FULL_FALLBACK_NATIVE_BENCHMARK_DIRECT generated_full_fallback=$IGC_GENERATED_FULL_FALLBACK"
    echo "[IGC-FALLBACK-CONFIG] new_counterexample_triggers_native=$IGC_FALLBACK_AFTER_EVERY_REFINED_NONVALID force_native_first=$IGC_FORCE_FULL_FALLBACK"
    echo "[IGC-FALLBACK-CONFIG] refined_time_gate=$IGC_CE_GUIDANCE_LIMIT_REFINED_TIME legacy_refined_timeout=$IGC_CE_GUIDANCE_REFINED_TIMEOUT candidate_timeout=$IGC_CANDIDATE_TIMEOUT"
    echo "[IGC-FALLBACK-CONFIG] ce_only_total_budget=$IGC_CE_ONLY_TOTAL_BUDGET probe_single_override=${IGC_CE_PROBE_SINGLE_TIMEOUT:-auto} probe_max_iterations_override=${IGC_CE_PROBE_MAX_REFINED_ITERATIONS:-auto} probe_total_override=${IGC_CE_PROBE_TOTAL_BUDGET:-auto}"
    echo "[IGC-FALLBACK-CONFIG] native_benchmark_root=$IGC_NATIVE_BENCHMARK_ROOT public_domain=$IGC_PUBLIC_DOMAIN_NAME public_problem=$IGC_PUBLIC_PROBLEM_BASENAME"
    echo "[IGC-FALLBACK-CONFIG] public_source_domain=$IGC_PUBLIC_SOURCE_DOMAIN public_source_problem=$IGC_PUBLIC_SOURCE_PROBLEM"
}

if bool_is_true "$IGC_PRINT_FALLBACK_CONFIG"; then
    print_fallback_config
fi

if [ -n "${IGC_FALLBACK_CONFIG_DUMP:-}" ]; then
    dump_dir=$(dirname "$IGC_FALLBACK_CONFIG_DUMP")
    mkdir -p "$dump_dir"
    {
        echo "IGC_FALLBACK_VERSION=v16-cff-cee-native-library"
        echo "IGC_FALLBACK_PROFILE=$IGC_FALLBACK_PROFILE"
        echo "IGC_CANDIDATE_PLANNER=$IGC_CANDIDATE_PLANNER"
        echo "IGC_CANDIDATE_RUNTIME_MODE=$IGC_CANDIDATE_RUNTIME_MODE"
        echo "IGC_PUBLIC_SOURCE_DOMAIN=$IGC_PUBLIC_SOURCE_DOMAIN"
        echo "IGC_PUBLIC_SOURCE_PROBLEM=$IGC_PUBLIC_SOURCE_PROBLEM"
        echo "IGC_PUBLIC_TEST_ROOT=$IGC_PUBLIC_TEST_ROOT"
        echo "IGC_PUBLIC_DOMAIN_NAME=$IGC_PUBLIC_DOMAIN_NAME"
        echo "IGC_PUBLIC_PROBLEM_BASENAME=$IGC_PUBLIC_PROBLEM_BASENAME"
        echo "IGC_NATIVE_BENCHMARK_ROOT=$IGC_NATIVE_BENCHMARK_ROOT"
        echo "IGC_FULL_FALLBACK_NATIVE_BENCHMARK_DIRECT=$IGC_FULL_FALLBACK_NATIVE_BENCHMARK_DIRECT"
        echo "IGC_FALLBACK_NATIVE_ONLY=$IGC_FALLBACK_NATIVE_ONLY"
        echo "IGC_GENERATED_FULL_FALLBACK=$IGC_GENERATED_FULL_FALLBACK"
        echo "IGC_FALLBACK_AFTER_EVERY_REFINED_NONVALID=$IGC_FALLBACK_AFTER_EVERY_REFINED_NONVALID"
        echo "IGC_FALLBACK_COUNTS_AS_ITERATION=$IGC_FALLBACK_COUNTS_AS_ITERATION"
        echo "IGC_FORCE_FULL_FALLBACK=$IGC_FORCE_FULL_FALLBACK"
        echo "IGC_ADAPTIVE_RENDER_PROFILE=$IGC_ADAPTIVE_RENDER_PROFILE"
        echo "IGC_CE_GUIDANCE_LIMIT_REFINED_TIME=$IGC_CE_GUIDANCE_LIMIT_REFINED_TIME"
        echo "IGC_CE_GUIDANCE_REFINED_TIMEOUT=$IGC_CE_GUIDANCE_REFINED_TIMEOUT"
        echo "IGC_CE_ONLY_TOTAL_BUDGET=$IGC_CE_ONLY_TOTAL_BUDGET"
        echo "IGC_CE_PROBE_SINGLE_TIMEOUT=$IGC_CE_PROBE_SINGLE_TIMEOUT"
        echo "IGC_CE_PROBE_MAX_REFINED_ITERATIONS=$IGC_CE_PROBE_MAX_REFINED_ITERATIONS"
        echo "IGC_CE_PROBE_TOTAL_BUDGET=$IGC_CE_PROBE_TOTAL_BUDGET"
        echo "IGC_CANDIDATE_TIMEOUT=$IGC_CANDIDATE_TIMEOUT"
        echo "IGC_FULL_FALLBACK_RESUME_AFTER_PLANNER_FAILURE=$IGC_FULL_FALLBACK_RESUME_AFTER_PLANNER_FAILURE"
        echo "IGC_SUPERB_MODE=$IGC_SUPERB_MODE"
    } > "$IGC_FALLBACK_CONFIG_DUMP"
    echo "[IGC-FALLBACK-CONFIG] 配置快照已写入：$IGC_FALLBACK_CONFIG_DUMP"
fi

case "$IGC_CANDIDATE_PLANNER" in
    t0|T0|translator-t0|translator_t0)
        export IGC_CANDIDATE_PLANNER=t0
        if [ -z "${IGC_T0_DIR:-}" ]; then
            if [ -x "$PWD/T0/translator-t0" ]; then
                IGC_T0_DIR=$PWD/T0
            elif [ -x "$PWD/t0/translator-t0" ]; then
                IGC_T0_DIR=$PWD/t0
            elif [ -x "$PWD/translator/translator/translator-t0" ]; then
                IGC_T0_DIR=$PWD/translator/translator
            elif [ -x "$PWD/translator/translator-t0" ]; then
                IGC_T0_DIR=$PWD/translator
            elif [ -x "$PWD/t0-planner/translator/translator/translator-t0" ]; then
                IGC_T0_DIR=$PWD/t0-planner/translator/translator
            else
                IGC_T0_DIR=$PWD/translator/translator
            fi
        fi
        export IGC_T0_DIR
