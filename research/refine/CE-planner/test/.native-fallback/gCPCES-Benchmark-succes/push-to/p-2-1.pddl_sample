(define (problem temp)(:domain push-to)(:objects 
   o1  - obj 
   p1-1  - pos 
   p1-2  - pos 
   p2-1  - pos 
   p2-2  - pos 
   int1  - interpretation 
   int2  - interpretation 
   int3  - interpretation 
)
(:init (true)
  (pick-loc p2-2 int1)
  (adj p1-1 p2-1 int1)
  (located p1-1 int1)
  (adj p2-1 p2-2 int1)
  (adj p1-2 p1-1 int1)
  (adj p1-2 p2-2 int1)
  (pick-loc p1-1 int1)
  (obj-located o1 p1-1 int1)
  (adj p2-2 p2-1 int1)
  (adj p1-1 p1-2 int1)
  (adj p2-2 p1-2 int1)
  (adj p2-1 p1-1 int1)
  (pick-loc p2-2 int2)
  (adj p1-1 p2-1 int2)
  (located p1-1 int2)
  (adj p2-1 p2-2 int2)
  (adj p1-2 p1-1 int2)
  (obj-located o1 p1-2 int2)
  (adj p1-2 p2-2 int2)
  (pick-loc p1-1 int2)
  (adj p2-2 p2-1 int2)
  (adj p1-1 p1-2 int2)
  (adj p2-2 p1-2 int2)
  (adj p2-1 p1-1 int2)
  (located p1-1 int3)
  (pick-loc p1-1 int3)
  (adj p1-2 p1-1 int3)
  (adj p1-1 p1-2 int3)
  (adj p2-2 p1-2 int3)
  (pick-loc p2-2 int3)
  (adj p1-1 p2-1 int3)
  (adj p1-2 p2-2 int3)
  (adj p2-1 p2-2 int3)
  (adj p2-2 p2-1 int3)
  (obj-located o1 p2-1 int3)
  (adj p2-1 p1-1 int3)
)
(:goal (forall (?interpr - interpretation)(and   (holding o1 ?interpr)))))