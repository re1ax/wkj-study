(define (problem temp)(:domain d-ring-3)(:objects 
   w1  - window 
   w2  - window 
   w3  - window 
   int1  - interpretation 
   int2  - interpretation 
   int3  - interpretation 
   int4  - interpretation 
   int5  - interpretation 
)
(:init (true)
  (locked w2 int1)
  (pos w2 int1)
  (locked w3 int1)
  (open w1 int1)
  (locked w3 int2)
  (pos w3 int2)
  (closed w1 int2)
  (locked w2 int2)
  (closed w1 int3)
  (locked w3 int3)
  (pos w1 int3)
  (locked w2 int3)
  (open w1 int4)
  (open w2 int4)
  (pos w3 int4)
  (locked w3 int4)
  (open w1 int5)
  (closed w3 int5)
  (closed w2 int5)
  (pos w1 int5)
)
(:goal (forall (?interpr - interpretation)(and   (locked w1 ?interpr)  (locked w2 ?interpr)  (locked w3 ?interpr)))))