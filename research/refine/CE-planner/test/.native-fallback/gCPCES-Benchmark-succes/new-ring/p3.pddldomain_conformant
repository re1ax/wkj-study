(define (domain d-ring-new-3)
;(:requirements  :typing :equality)
(:types  object - object  window - object  interpretation - object )
(:constants 
   w1  - window 
   w2  - window 
   w3  - window 
)

(:predicates (true)   (pos ?w - window  ?x - interpretation)  (closed ?w - window  ?x - interpretation)  (open ?w - window  ?x - interpretation)  (locker_damaged ?w - window  ?x - interpretation)  (locked ?w - window  ?x - interpretation)) 
(:action bwd
:parameters ()
:effect (and (forall (?interpr - interpretation) (when   (pos w1 ?interpr) (and   (pos w3 ?interpr)(not   (pos w1 ?interpr)))))(forall (?interpr - interpretation) (when   (pos w2 ?interpr) (and   (pos w1 ?interpr)(not   (pos w2 ?interpr)))))(forall (?interpr - interpretation) (when   (pos w3 ?interpr) (and   (pos w2 ?interpr)(not   (pos w3 ?interpr)))))))
(:action close
:parameters ()
:effect (and (forall (?interpr - interpretation) (when   (pos w1 ?interpr) (and   (closed w1 ?interpr))))(forall (?interpr - interpretation) (when   (pos w2 ?interpr) (and   (closed w2 ?interpr))))(forall (?interpr - interpretation) (when   (pos w3 ?interpr) (and   (closed w3 ?interpr))))))
(:action fwd
:parameters ()
:effect (and (forall (?interpr - interpretation) (when   (pos w1 ?interpr) (and   (pos w2 ?interpr)(not   (pos w1 ?interpr)))))(forall (?interpr - interpretation) (when   (pos w2 ?interpr) (and   (pos w3 ?interpr)(not   (pos w2 ?interpr)))))(forall (?interpr - interpretation) (when   (pos w3 ?interpr) (and   (pos w1 ?interpr)(not   (pos w3 ?interpr)))))))
(:action lock
:parameters ()
:effect (and (forall (?interpr - interpretation) (when (and   (pos w1 ?interpr)  (closed w1 ?interpr)(not   (locker_damaged w1 ?interpr))) (and   (locked w1 ?interpr))))(forall (?interpr - interpretation) (when (and   (pos w2 ?interpr)  (closed w2 ?interpr)(not   (locker_damaged w2 ?interpr))) (and   (locked w2 ?interpr))))(forall (?interpr - interpretation) (when (and   (pos w3 ?interpr)  (closed w3 ?interpr)(not   (locker_damaged w3 ?interpr))) (and   (locked w3 ?interpr))))))

)