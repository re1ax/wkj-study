
(define (domain or-push-to) 

   (:requirements :strips)
   (:constants  o1 o2 o3 o4 o5 o6 o7 o8 o9 o10 o11 o12 o13 o14 o15 o16 o17 o18 o19 o20 o21 o22 o23 o24 o25 o26 o27 o28 o29 o30 o31 o32 o33 o34 o35 o36 o37 o38 o39 o40) 
   (:predicates (adj ?i ?j) (at ?i) (holding ?o) (obj-at ?o ?i)
                (pick-loc ?i))
   (:action move
      :parameters (?i ?j)
      :precondition (and (adj ?i ?j) (at ?i))
      :effect (and (not (at ?i)) (at ?j)))
   (:action pickup
      :parameters (?o ?i)
      :precondition (and (at ?i) (pick-loc ?i))
      :effect (when (obj-at ?o ?i) (and (holding ?o) (not (obj-at ?o ?i)))))
   (:action push
      :parameters (?i ?j)
      :precondition (and (adj ?i ?j) (at ?i))
      :effect (and 
                 (when (obj-at o1 ?i) (and (obj-at o1 ?j) (not (obj-at o1 ?i))))
                 (when (obj-at o2 ?i) (and (obj-at o2 ?j) (not (obj-at o2 ?i))))
                 (when (obj-at o3 ?i) (and (obj-at o3 ?j) (not (obj-at o3 ?i))))
                 (when (obj-at o4 ?i) (and (obj-at o4 ?j) (not (obj-at o4 ?i))))
                 (when (obj-at o5 ?i) (and (obj-at o5 ?j) (not (obj-at o5 ?i))))
                 (when (obj-at o6 ?i) (and (obj-at o6 ?j) (not (obj-at o6 ?i))))
                 (when (obj-at o7 ?i) (and (obj-at o7 ?j) (not (obj-at o7 ?i))))
                 (when (obj-at o8 ?i) (and (obj-at o8 ?j) (not (obj-at o8 ?i))))
                 (when (obj-at o9 ?i) (and (obj-at o9 ?j) (not (obj-at o9 ?i))))
                 (when (obj-at o10 ?i) (and (obj-at o10 ?j) (not (obj-at o10 ?i))))
                 (when (obj-at o11 ?i) (and (obj-at o11 ?j) (not (obj-at o11 ?i))))
                 (when (obj-at o12 ?i) (and (obj-at o12 ?j) (not (obj-at o12 ?i))))
                 (when (obj-at o13 ?i) (and (obj-at o13 ?j) (not (obj-at o13 ?i))))
                 (when (obj-at o14 ?i) (and (obj-at o14 ?j) (not (obj-at o14 ?i))))
                 (when (obj-at o15 ?i) (and (obj-at o15 ?j) (not (obj-at o15 ?i))))
                 (when (obj-at o16 ?i) (and (obj-at o16 ?j) (not (obj-at o16 ?i))))
                 (when (obj-at o17 ?i) (and (obj-at o17 ?j) (not (obj-at o17 ?i))))
                 (when (obj-at o18 ?i) (and (obj-at o18 ?j) (not (obj-at o18 ?i))))
                 (when (obj-at o19 ?i) (and (obj-at o19 ?j) (not (obj-at o19 ?i))))
                 (when (obj-at o20 ?i) (and (obj-at o20 ?j) (not (obj-at o20 ?i))))
                 (when (obj-at o21 ?i) (and (obj-at o21 ?j) (not (obj-at o21 ?i))))
                 (when (obj-at o22 ?i) (and (obj-at o22 ?j) (not (obj-at o22 ?i))))
                 (when (obj-at o23 ?i) (and (obj-at o23 ?j) (not (obj-at o23 ?i))))
                 (when (obj-at o24 ?i) (and (obj-at o24 ?j) (not (obj-at o24 ?i))))
                 (when (obj-at o25 ?i) (and (obj-at o25 ?j) (not (obj-at o25 ?i))))
                 (when (obj-at o26 ?i) (and (obj-at o26 ?j) (not (obj-at o26 ?i))))
                 (when (obj-at o27 ?i) (and (obj-at o27 ?j) (not (obj-at o27 ?i))))
                 (when (obj-at o28 ?i) (and (obj-at o28 ?j) (not (obj-at o28 ?i))))
                 (when (obj-at o29 ?i) (and (obj-at o29 ?j) (not (obj-at o29 ?i))))
                 (when (obj-at o30 ?i) (and (obj-at o30 ?j) (not (obj-at o30 ?i))))
                 (when (obj-at o31 ?i) (and (obj-at o31 ?j) (not (obj-at o31 ?i))))
                 (when (obj-at o32 ?i) (and (obj-at o32 ?j) (not (obj-at o32 ?i))))
                 (when (obj-at o33 ?i) (and (obj-at o33 ?j) (not (obj-at o33 ?i))))
                 (when (obj-at o34 ?i) (and (obj-at o34 ?j) (not (obj-at o34 ?i))))
                 (when (obj-at o35 ?i) (and (obj-at o35 ?j) (not (obj-at o35 ?i))))
                 (when (obj-at o36 ?i) (and (obj-at o36 ?j) (not (obj-at o36 ?i))))
                 (when (obj-at o37 ?i) (and (obj-at o37 ?j) (not (obj-at o37 ?i))))
                 (when (obj-at o38 ?i) (and (obj-at o38 ?j) (not (obj-at o38 ?i))))
                 (when (obj-at o39 ?i) (and (obj-at o39 ?j) (not (obj-at o39 ?i))))
                 (when (obj-at o40 ?i) (and (obj-at o40 ?j) (not (obj-at o40 ?i)))))
      ))

