(define (problem temp)(:domain d-ring-4)(:objects 
   w1  - window 
   w2  - window 
   w3  - window 
   w4  - window 
   int1  - interpretation 
   int2  - interpretation 
   int3  - interpretation 
   int4  - interpretation 
   int5  - interpretation 
   int6  - interpretation 
   int7  - interpretation 
)
(:init (true)
  (locked w3 int1)
  (pos w1 int1)
  (open w1 int1)
  (locked w4 int1)
  (locked w2 int1)
  (locked w3 int2)
  (pos w1 int2)
  (closed w4 int2)
  (closed w1 int2)
  (locked w2 int2)
  (pos w2 int3)
  (closed w1 int3)
  (locked w3 int3)
  (closed w4 int3)
  (locked w2 int3)
  (pos w2 int4)
  (closed w3 int4)
  (closed w1 int4)
  (closed w4 int4)
  (locked w2 int4)
  (closed w1 int5)
  (locked w3 int5)
  (closed w4 int5)
  (open w2 int5)
  (pos w4 int5)
  (pos w2 int6)
  (open w1 int6)
  (closed w4 int6)
  (locked w2 int6)
  (closed w3 int6)
  (open w1 int7)
  (locked w3 int7)
  (closed w4 int7)
  (locked w2 int7)
  (pos w4 int7)
)
(:goal (forall (?interpr - interpretation)(and   (locked w1 ?interpr)  (locked w2 ?interpr)  (locked w3 ?interpr)  (locked w4 ?interpr)))))