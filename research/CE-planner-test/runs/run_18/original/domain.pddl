(define (domain uts_cycle_3)
 (:requirements :adl)
 (:types node label)
 (:constants n0 n1 n2 - node)
 (:predicates (visited ?n - node) (edge_label ?a ?b - node ?l - label) (at_node ?n - node))
 (:action follow_label
  :parameters (?label - label)
  :precondition (and)
  :effect (and
   (when (and (at_node n0) (edge_label n0 n1 ?label)) (and (at_node n1) (visited n1)))
   (when (and (at_node n0) (edge_label n0 n2 ?label)) (and (at_node n2) (visited n2)))
   (when (and (at_node n1) (edge_label n1 n2 ?label)) (and (at_node n2) (visited n2)))
   (when (and (at_node n1) (edge_label n1 n0 ?label)) (and (at_node n0) (visited n0)))
   (when (and (at_node n2) (edge_label n2 n0 ?label)) (and (at_node n0) (visited n0)))
   (when (and (at_node n2) (edge_label n2 n1 ?label)) (and (at_node n1) (visited n1)))
   (when (and (at_node n0) (or (edge_label n0 n1 ?label) (edge_label n0 n2 ?label)) (not (and (at_node n1) (edge_label n1 n0 ?label))) (not (and (at_node n2) (edge_label n2 n0 ?label)))) (not (at_node n0)))
   (when (and (at_node n1) (or (edge_label n1 n0 ?label) (edge_label n1 n2 ?label)) (not (and (at_node n0) (edge_label n0 n1 ?label))) (not (and (at_node n2) (edge_label n2 n1 ?label)))) (not (at_node n1)))
   (when (and (at_node n2) (or (edge_label n2 n0 ?label) (edge_label n2 n1 ?label)) (not (and (at_node n0) (edge_label n0 n2 ?label))) (not (and (at_node n1) (edge_label n1 n2 ?label)))) (not (at_node n2)))
  )
 )
)
