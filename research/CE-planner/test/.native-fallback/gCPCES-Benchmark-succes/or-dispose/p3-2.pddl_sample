  (obj_at o1 p3_2 int17)
  (located p2_2 int17)
  (adj p3_1 p2_1 int17)
  (adj p1_1 p1_2 int17)
  (obj_at o1 p1_1 int17)
)
(:goal (forall (?interpr - interpretation)(and   (disposed o1 ?interpr)  (disposed o2 ?interpr)))))