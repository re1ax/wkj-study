(define (domain or-push-new)
;(:requirements  :strips :typing)
(:types  object - object  pos - object  obj - object  interpretation - object )
(:constants 
   o1  - obj 
   o2  - obj 
)

(:predicates (true)   (pick-loc ?i - pos  ?x - interpretation)  (located ?i - pos  ?x - interpretation)  (holding ?o - obj  ?x - interpretation)  (ncleared ?i - pos  ?x - interpretation)  (obj-located ?o - obj  ?i - pos  ?x - interpretation)  (adj ?i - pos  ?j - pos  ?x - interpretation)) 
(:action move
:parameters (?i  - pos ?j  - pos )
:precondition (forall (?interpr - interpretation)(and   (adj ?i ?j ?interpr)  (located ?i ?interpr)  (ncleared ?j ?interpr)))
:effect (and (forall (?interpr - interpretation)   (located ?j ?interpr))(forall (?interpr - interpretation) (not   (located ?i ?interpr)))))
(:action pickup
:parameters (?i  - pos )
:precondition (forall (?interpr - interpretation)(and   (located ?i ?interpr)  (pick-loc ?i ?interpr)))
:effect (and (forall (?interpr - interpretation) (when   (obj-located o1 ?i ?interpr) (and   (holding o1 ?interpr)(not   (obj-located o1 ?i ?interpr)))))(forall (?interpr - interpretation) (when   (obj-located o2 ?i ?interpr) (and   (holding o2 ?interpr)(not   (obj-located o2 ?i ?interpr)))))))
(:action push
:parameters (?i  - pos ?j  - pos )
:precondition (forall (?interpr - interpretation)(and   (adj ?i ?j ?interpr)  (located ?i ?interpr)))
:effect (and (forall (?interpr - interpretation) (not   (ncleared ?i ?interpr)))(forall (?interpr - interpretation) (when   (obj-located o1 ?i ?interpr) (and   (obj-located o1 ?j ?interpr)(not   (obj-located o1 ?i ?interpr))  (ncleared ?j ?interpr))))(forall (?interpr - interpretation) (when   (obj-located o2 ?i ?interpr) (and   (obj-located o2 ?j ?interpr)(not   (obj-located o2 ?i ?interpr))  (ncleared ?j ?interpr))))))

)