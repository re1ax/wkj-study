(:action pickup-1-2-look-1
:parameters ()
:precondition (forall (?interpr - interpretation)(and   (located p1-2 ?interpr)))
:effect (and (forall (?interpr - interpretation) (when   (holding o1 ?interpr) (and   (handempty ?interpr)(not   (holding o1 ?interpr))  (obj-located o1 p1-2 ?interpr))))(forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 p1-1 ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 p1-1 ?interpr)))))(forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 p1-2 ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 p1-2 ?interpr)))))(forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 p2-1 ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 p2-1 ?interpr)))))(forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 p2-2 ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 p2-2 ?interpr)))))))
(:action pickup-2-1-look-1
:parameters ()
:precondition (forall (?interpr - interpretation)(and   (located p2-1 ?interpr)))
:effect (and (forall (?interpr - interpretation) (when   (holding o1 ?interpr) (and   (handempty ?interpr)(not   (holding o1 ?interpr))  (obj-located o1 p2-1 ?interpr))))(forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 p1-1 ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 p1-1 ?interpr)))))(forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 p1-2 ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 p1-2 ?interpr)))))(forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 p2-1 ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 p2-1 ?interpr)))))(forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 p2-2 ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 p2-2 ?interpr)))))))
(:action pickup-2-2-look-1
:parameters ()
:precondition (forall (?interpr - interpretation)(and   (located p2-2 ?interpr)))
:effect (and (forall (?interpr - interpretation) (when   (holding o1 ?interpr) (and   (handempty ?interpr)(not   (holding o1 ?interpr))  (obj-located o1 p2-2 ?interpr))))(forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 p1-1 ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 p1-1 ?interpr)))))(forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 p1-2 ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 p1-2 ?interpr)))))(forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 p2-1 ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 p2-1 ?interpr)))))(forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 p2-2 ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 p2-2 ?interpr)))))))
(:action putdown
:parameters (?p  - pos )
:precondition (forall (?interpr - interpretation)(and   (located ?p ?interpr)))
:effect (and (forall (?interpr - interpretation) (when   (holding o1 ?interpr) (and   (handempty ?interpr)(not   (holding o1 ?interpr))  (obj-located o1 ?p ?interpr))))))

)