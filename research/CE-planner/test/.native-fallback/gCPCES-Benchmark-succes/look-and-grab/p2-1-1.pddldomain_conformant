(define (domain look-and-grab)
;(:requirements  :strips :typing)
(:types  object - object  pos - object  obj - object  interpretation - object )
(:constants 
   o1  - obj 
   p1-1  - pos 
   p1-2  - pos 
   p2-1  - pos 
   p2-2  - pos 
)

(:predicates (true)   (located ?i - pos  ?x - interpretation)  (holding ?o - obj  ?x - interpretation)  (obj-located ?o - obj  ?i - pos  ?x - interpretation)  (handempty ?x - interpretation)  (adj ?i - pos  ?j - pos  ?x - interpretation)) 
(:action move
:parameters (?i  - pos ?j  - pos )
:precondition (forall (?interpr - interpretation)(and   (adj ?i ?j ?interpr)  (located ?i ?interpr)))
:effect (and (forall (?interpr - interpretation)   (located ?j ?interpr))(forall (?interpr - interpretation) (not   (located ?i ?interpr)))))
(:action pickup-1-1-look-1
:parameters ()
:precondition (forall (?interpr - interpretation)(and   (located p1-1 ?interpr)))
