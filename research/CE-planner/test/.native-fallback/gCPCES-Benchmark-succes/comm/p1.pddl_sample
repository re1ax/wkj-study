(define (problem temp)(:domain comm)(:objects 
   s0  - stage 
   s1  - stage 
   s2  - stage 
   s3  - stage 
   s4  - stage 
   p0  - packet 
   p1  - packet 
   int1  - interpretation 
   int2  - interpretation 
   int3  - interpretation 
)
(:init (true)
  (current-stage s0 int1)
  (seq-number p0 s0 int1)
  (next-stage s3 s4 int1)
  (next-stage s1 s2 int1)
  (in-channel p1 int1)
  (in-channel p0 int1)
  (seq-number p1 s1 int1)
  (next-stage s0 s1 int1)
  (next-stage s2 s3 int1)
  (next-stage s2 s3 int2)
  (in-channel p1 int2)
  (in-channel p0 int2)
  (next-stage s1 s2 int2)
  (seq-number p0 s0 int2)
  (seq-number p1 s1 int2)
  (next-stage s0 s1 int2)
  (noisy p0 int2)
  (current-stage s0 int2)
  (next-stage s3 s4 int2)
  (in-channel p1 int3)
  (seq-number p1 s1 int3)
  (current-stage s0 int3)
  (noisy p1 int3)
  (next-stage s2 s3 int3)
  (in-channel p0 int3)
  (next-stage s1 s2 int3)
  (seq-number p0 s0 int3)
  (next-stage s0 s1 int3)
  (next-stage s3 s4 int3)
  (bad p0 int3)
)
(:goal (forall (?interpr - interpretation)(and   (ok p0 ?interpr)  (ok p1 ?interpr)))))