   int3  - interpretation 
)
(:init (true)
  (y p5 int1)
  (x p1 int1)
  (x p4 int2)
  (y p5 int2)
  (x p2 int2)
  (x p3 int3)
  (x p5 int3)
  (x p2 int3)
  (y p1 int3)
)
