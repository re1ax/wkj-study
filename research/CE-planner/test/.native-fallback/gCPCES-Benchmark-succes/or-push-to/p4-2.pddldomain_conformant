(define (domain or-push-to)
;(:requirements  :strips :typing)
(:types  object - object  interpretation - object )
(:predicates (true)   (holding ?o - object  ?x - interpretation)  (pick-loc ?i - object  ?x - interpretation)  (obj-located ?o - object  ?i - object  ?x - interpretation)  (located ?i - object  ?x - interpretation)  (adj ?i - object  ?j - object  ?x - interpretation)) 
(:action move
:parameters (?i  - object ?j  - object )
:precondition (forall (?interpr - interpretation)(and   (adj ?i ?j ?interpr)  (located ?i ?interpr)))
:effect (and (forall (?interpr - interpretation)   (located ?j ?interpr))(forall (?interpr - interpretation) (not   (located ?i ?interpr)))))
(:action pickup
:parameters (?o  - object ?i  - object )
:precondition (forall (?interpr - interpretation)(and   (located ?i ?interpr)  (pick-loc ?i ?interpr)))
:effect (and (forall (?interpr - interpretation) (when   (obj-located ?o ?i ?interpr) (and   (holding ?o ?interpr)(not   (obj-located ?o ?i ?interpr)))))))
(:action push
:parameters (?o  - object ?i  - object ?j  - object )
:precondition (forall (?interpr - interpretation)(and   (adj ?i ?j ?interpr)  (located ?i ?interpr)))
:effect (and (forall (?interpr - interpretation) (when   (obj-located ?o ?i ?interpr) (and   (obj-located ?o ?j ?interpr)(not   (obj-located ?o ?i ?interpr)))))))

)