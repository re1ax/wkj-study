(define (domain to-trash)
;(:requirements  :strips :typing)
(:types  object - object  pos - object  obj - object  interpretation - object )
(:constants 
   o1  - obj 
)

(:predicates (true)   (located ?i - pos  ?x - interpretation)  (holding ?o - obj  ?x - interpretation)  (obj-located ?o - obj  ?i - pos  ?x - interpretation)  (handempty ?x - interpretation)  (adj ?i - pos  ?j - pos  ?x - interpretation)) 
(:action move
:parameters (?i  - pos ?j  - pos )
:precondition (forall (?interpr - interpretation)(and   (adj ?i ?j ?interpr)  (located ?i ?interpr)))
:effect (and (forall (?interpr - interpretation)   (located ?j ?interpr))(forall (?interpr - interpretation) (not   (located ?i ?interpr)))))
(:action pickup
:parameters (?p  - pos )
:precondition (forall (?interpr - interpretation)(and   (located ?p ?interpr)))
:effect (and (forall (?interpr - interpretation) (when (and   (handempty ?interpr)  (obj-located o1 ?p ?interpr)) (and (not   (handempty ?interpr))  (holding o1 ?interpr)(not   (obj-located o1 ?p ?interpr)))))(forall (?interpr - interpretation) (when   (holding o1 ?interpr) (and   (handempty ?interpr)(not   (holding o1 ?interpr)))))))
(:action putdown
:parameters (?p  - pos )
:precondition (forall (?interpr - interpretation)(and   (located ?p ?interpr)))
:effect (and (forall (?interpr - interpretation) (when   (holding o1 ?interpr) (and   (handempty ?interpr)(not   (holding o1 ?interpr))  (obj-located o1 ?p ?interpr))))))

)