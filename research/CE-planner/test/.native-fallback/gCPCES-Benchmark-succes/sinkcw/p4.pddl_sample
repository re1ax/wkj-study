(define (problem temp)(:domain grid)(:objects 
   zero  - num 
   one  - num 
   two  - num 
   three  - num 
   int1  - interpretation 
   int2  - interpretation 
   int3  - interpretation 
   int4  - interpretation 
   int5  - interpretation 
   int6  - interpretation 
)
(:init (true)
  (x zero int1)
  (y zero int1)
  (x zero int2)
  (y one int2)
  (x one int3)
  (y one int3)
  (canmove int3)
  (x zero int4)
  (y three int4)
  (y two int5)
  (canmove int5)
  (x three int5)
  (x three int6)
  (y three int6)
)
(:goal (forall (?interpr - interpretation)(and   (x two ?interpr)  (y zero ?interpr)))))