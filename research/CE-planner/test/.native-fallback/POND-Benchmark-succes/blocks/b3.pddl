(define (problem b3)
  (:domain blocks)
  (:objects A B C - block)
  (:init
    (and
        (oneof (handempty) (holding A) (holding B) (holding C))
        (oneof (holding A) (clear A) (on B A) (on C A))
        (oneof (holding A) (ontable A) (on A B) (on A C))
        (oneof (holding B) (clear B) (on A B) (on C B))
        (oneof (holding B) (ontable B) (on B A) (on B C))
        (oneof (holding C) (clear C) (on A C) (on B C))
        (oneof (holding C) (ontable C) (on C A) (on C B))
        (or (not (on A B)) (not (on B A)))
        (or (not (on A C)) (not (on C A)))
        (or (not (on B C)) (not (on C B)))
        (or (not (on A B)) (not (on B C)) (not (on C A)))
        (or (not (on A C)) (not (on C B)) (not (on B A)))
    )
  )
  
  (:goal (and (ontable A) (on B A) (on C B)))
)
